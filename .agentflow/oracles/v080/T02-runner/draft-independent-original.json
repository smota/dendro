    "answer_status_ok_required": true,
    "modes_are_disjoint": ["warmup", "warm_answer", "cold_migration", "replay", "seven_answer_home", "ui_blocking"],
    "percentile": {
      "name": "nearest_rank_ceil",
      "allowed": [50, 95],
      "sorted": "ascending",
      "rank_1_based": "(p * n + 99) // 100",
      "value": "sorted[rank_1_based - 1]",
      "n_0": "undefined, blocked_unmeasured, value null",
      "median": "nearest_rank_ceil p50, not the mean of the two central observations",
      "worst": "maximum of the eligible population",
      "best": "minimum of the eligible population",
      "spread_ns": "worst_ns - best_ns"
