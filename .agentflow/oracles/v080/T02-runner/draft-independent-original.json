    "eligible_sample": "mode matches the metric, phase is measured, candidate exit code is 0, termination_reason is none, probe did not time out, elapsed_ns is a uint64, clock is monotonic",
    "warmup_exclusion": ["percentile population", "median", "worst", "spread", "throughput answers", "throughput elapsed", "minimum_answer_calls"],
    "throughput": {
      "direction": "higher_is_better",
      "answers": "eligible warm_answer measured call count",
      "elapsed_ns": "sum of those same samples",
      "rate": "answers / elapsed_ns as a rational",
      "regression_exceeded_iff": "5 * candidate_answers * baseline_elapsed_ns < 4 * baseline_answers * candidate_elapsed_ns",
      "equality_at_20_of_100": "passes",
      "arithmetic": "Python integers, arbitrary precision. Inputs must fit uint64. Intermediate products may exceed uint64 and must not wrap.",
      "baseline_answers_0": "refused_noncomparable, regression null",
      "either_elapsed_0": "invalid_elapsed, throughput null, refused_noncomparable",
      "candidate_answers_0_with_positive_baseline_and_positive_elapsed": "comparable, regression exceeded"
