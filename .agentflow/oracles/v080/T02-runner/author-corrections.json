[{"op":"add","path":"/review_rejections","value":["Reject elapsed_ns 0 as an eligible sample, and reject dropping performance_success false without a rule. Eligibility is elapsed_ns>=1; 0 is blocked_unmeasured, runner_exit 6.","Reject UI blocking as subprocess time. Keep the 50ms target. Require a bound UI event-loop trace; if absent, blocked_unmeasured.","Reject polled Linux VmHWM as reliable_peak. VmHWM polling is sampled_maximum only. Reliable peak is waited-child rusage or an equivalent verified collector.","Reject a frozen v070 bench-answer CLI. Probe the real pinned command. Failure stays not_measurable_preport.","Reject modulus 2250 on every profile and reject emitting impossible chain or layer targets.","Reject a missing descendant collector as child count 0.","Reject budget_pass false when the schema is invalid. Use null.","Reject mode warm. The mode is warm_answer.","Reject unknown answer fields. The only ignored field is documented elapsed_ms, and that field is removed from the parsed-counts fixture.","Reject no-cold-regression and reject a cold latency cap. Candidate and baseline each use exactly 5 reps; comparison is the same 20/100 completed-units/elapsed rule.","Reject label in_process_warm. Measured warm samples are process_warm_os_cache and include process startup and db open."]},{"op":"replace","path":"/specified_protocol/eligible_sample","value":"mode matches the metric, phase is measured, candidate exit 0, termination_reason none, no timeout, clock monotonic, elapsed_ns is a uint64 and elapsed_ns>=1. Zero is not eligible."},{"op":"replace","path":"/specified_protocol/surface_rule","value":"v080 is the only frozen benchmark argv. v070 is not a claimed CLI. Probe the real pinned command and do not invent or rewrite it into v080. A failed, absent, or nonzero probe is not_measurable_preport. Any other v080 argv is unsupported_surface."},{"op":"replace","path":"/specified_protocol/surfaces","value":{"v080":["{candidate}","benchmark","answer","--protocol","dendro.bench.answer/v1","--request","{request_path}"],"v070":"not a frozen CLI"}},{"op":"add","path":"/specified_protocol/answer_unknown_fields","value":"Reject unknown response fields. The only exception is elapsed_ms, which is ignored and is never a sample."},{"op":"add","path":"/specified_protocol/warm_procedure","value":{"warmups_exact":2,"warm_answer_repetitions_min":20,"per":"one selected question","selected_question_id":"attempt-{profile}-{seed}-00000","seeds":{"corpus":8675309,"profile_material":8675309,"warm_sequence":8675309},"entropy":"forbidden","measurement_label":"process_warm_os_cache","includes":["process_startup","db_open"],"forbidden_label":"in_process_warm","warmup_phase":"excluded from percentile, median, worst, spread, throughput, and minimum_answer_calls"}},{"op":"add","path":"/specified_protocol/budget_aggregation","value":{"seven_answer_home":"maximum elapsed_ns of n>=1 eligible samples; each sample answer_count is 7; n=0 is blocked_unmeasured","ui_blocking":"maximum elapsed_ns of n>=1 trace samples; n=0 or absent trace is blocked_unmeasured","schema_mismatch_budget_pass":null}},{"op":"add","path":"/specified_protocol/ui_blocking","value":{"max_ns":50000000,"source":"independently instrumented UI event-loop trace","required_input":["candidate_binding","method","clock","samples_ns"],"method":"ui_event_loop_trace","clock":"monotonic","subprocess_elapsed_forbidden":true,"absent":{"status":"blocked_unmeasured","value":null,"forbidden_value":0,"runner_exit":6}}},{"op":"replace","path":"/specified_protocol/memory_methods/large_peak","value":{"metric":"large_reliable_peak_rss_bytes","allowed_methods":["reliable_peak"],"windows_source":"win32.GetProcessMemoryInfo.PeakWorkingSetSize","windows_requirement":"The spawning process handle stays open through exit and the peak is read from that handle; otherwise blocked_unmeasured.","linux_reliable_source":"waited child rusage ru_maxrss, bytes=ru_maxrss*1024, or an equivalent verified waited-child peak collector in bytes","linux_vmhwm_polling":"sampled_maximum only","absent_collector":{"status":"blocked_unmeasured","value":null,"forbidden_value":0,"runner_exit":6},"scope":"candidate_process","sampled_maximum_satisfies_peak":false}},{"op":"add","path":"/specified_protocol/cold_migration","value":{"candidate_reps":5,"baseline_reps":5,"four_reps":{"status":"blocked_unmeasured","runner_exit":6},"six_reps":{"status":"schema_mismatch","runner_exit":5},"latency_cap":"none","comparison":"completed_units/elapsed_ns, higher is better","exceeded_iff":"5*candidate_units*baseline_elapsed_ns < 4*baseline_units*candidate_elapsed_ns","equality_20_of_100":"passes","arithmetic":"Python int, no uint64 wrap","units":"sum of per-rep completed_units over exactly 5 eligible reps","elapsed":"sum of per-rep elapsed_ns, each elapsed_ns>=1"}},{"op":"replace","path":"/specified_protocol/process_tree_counts","value":"Count the harness, the candidate, and every descendant of the candidate. The bound is 2, so any descendant overruns it. A runtime collector must prove the count. Windows uses a Job Object; Linux uses the waited process-group or equivalent. If the collector is absent, the count is unknown, not 0, status blocked_unmeasured, runner_exit 6."},{"op":"add","path":"/frozen_corpus/seeds","value":{"corpus":8675309,"profile_material":8675309,"warm_sequence":8675309,"entropy":"forbidden"}},{"op":"add","path":"/frozen_corpus/target_rules","value":{"single":"k % profile.chain_count, depth 0","multi":"m % profile.full_chain_count, depth 4","small":{"chain_count":2250,"full_chain_count":2250},"micro":{"chain_count":3,"full_chain_count":2,"k18_chain":0,"k18_target":"node-micro-8675309-0000-0"},"impossible":"If the chain or configured layer is absent, schema_mismatch. Do not reduce that index modulo 2250."}},{"op":"add","path":"/frozen_corpus/serialization","value":{"format":"JSONL","encoding":"UTF-8","bom":false,"newline":"LF","final_line_ends_with_lf":true,"floats":false,"null_allowed":true,"ke