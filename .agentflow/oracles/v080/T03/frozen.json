{
  "oracle_version": "domain-1.0.0/relationship-contract-v1/corrections_at_cutoff_v1",
  "task_id": "T03",
  "cases": [
    {
      "id": "T03-01",
      "rule": "Source-instance identity is authority namespace plus producer incarnation. A directory name or configured root token does not unify or split identity. Trust labels verified_signature, authenticated_transport, and unverified stay distinct.",
      "input": {
        "left": {
          "authority_namespace": "ns-alpha",
          "producer_incarnation": "inc-1",
          "product": "same-product",
          "configured_root_token": "root-shared",
          "trust_label": "verified_signature"
        },
        "right": {
          "authority_namespace": "ns-beta",
          "producer_incarnation": "inc-2",
          "product": "same-product",
          "configured_root_token": "root-shared",
          "trust_label": "authenticated_transport"
        }
      },
      "expected": {
        "status": "accept",
        "source_instances": "distinct",
        "unified_by_root_token": "refuse",
        "trust_labels_collapsed": "refuse"
      }
    },
    {
      "id": "T03-02",
      "rule": "A new source generation retains predecessor evidence. Identical bytes in a replaced file do not automatically establish cross-generation equivalence.",
      "input": {
        "source_key": "file-key-1",
        "generation_1": {
          "source_generation": 1,
          "artifact_digest": "digest-same"
        },
        "generation_2": {
          "source_generation": 2,
          "artifact_digest": "digest-same",
          "predecessor_generation": 1
        }
      },
      "expected": {
        "status": "accept",
        "generations": "distinct",
        "predecessor_evidence": "retained",
        "automatic_cross_generation_equivalence": "refuse"
      }
    },
    {
      "id": "T03-03",
      "rule": "OpenRig rig, seat, and mission names cannot confer identity or authority. Colliding display labels stay distinct typed bindings. Required identity fields cannot be filled with display-name sentinels.",
      "input": {
        "bindings": [
          {
            "native_id": "seat-1",
            "display_label": "primary"
          },
          {
            "native_id": "seat-2",
            "display_label": "primary"
          }
        ],
        "collision": "recorded"
      },
      "expected": {
        "status": "accept",
        "identities": "distinct",
        "collision": "visible",
        "name_confers_identity": "refuse",
        "name_confers_authority": "refuse",
        "display_name_sentinel_for_required_id": "refuse"
      }
    },
    {
      "id": "T03-04",
      "rule": "A usage observation with no invocation and no attempt remains valid. Call evidence is required for a model invocation. No execution attempt is manufactured for a usage row.",
      "input": {
        "usage_observation": {
          "observation_id": "usage-1",
          "invocation_id": null,
          "attempt_id": null,
          "component_vector": {
            "input_tokens": 10,
            "output_tokens": 4
          },
          "evidence_ids": [
            "ev-usage-1"
          ]
        }
      },
      "expected": {
        "status": "accept",
        "usage_observation": "accepted",
        "model_invocation": "refuse_manufacture",
        "execution_attempt": "refuse_manufacture"
      }
    },
    {
      "id": "T03-05",
      "rule": "Missing parents and missing edge endpoints stay unresolved references. They are not newly inferred roots, and they are ineligible for reachability.",
      "input": {
        "edge": {
          "kind": "spawn",
          "creator_endpoint": null,
          "target_attempt": "attempt-child",
          "evidence_ids": [
            "ev-edge-1"
          ]
        }
      },
      "expected": {
        "status": "unresolved",
        "missing_endpoint": "unresolved",
        "fabricated_root": "refuse",
        "fabricated_creator_assignment": "refuse",
        "reachability": "ineligible",
        "evidence": "preserved"
      }
    },
    {
      "id": "T03-06",
      "rule": "An unrecognized enum value is quarantined with its count and is never mapped to success or coerced into a closed variant.",
      "input": {
        "record": "execution_attempt",
        "field": "result",
        "value": "partial_success",
        "closed_values": [
          "succeeded",
          "failed",
          "cancelled",
          "unknown"
        ],
        "count": 3
      },
      "expected": {
        "status": "quarantine",
        "quarantine_count": 3,
        "mapped_to_succeeded": "refuse",
        "mapped_to_closed_unknown": "refuse",
        "accepted_result": "refuse"
      }
    },
    {
      "id": "T03-07",
      "rule": "A message observation keeps direction, role, modality, order, clock, and safe metadata counts only. It stores no body, excerpt, or arbitrary text. A first-user message exists only when source sequence proves it.",
      "input": {
        "direction": "inbound",
        "role": "assistant",
        "modalities": [
          "text"
        ],
        "grain": "message",
        "body": "reset the secret now",
        "excerpt": "reset the secret",
        "metadata_counts": {
          "characters": 20
        },
        "capture": "partial",
        "source_sequence_proves_first_user": false
      },
      "expected": {
        "status": "accept",
        "observation_without_text": "accepted",
        "body_retained": "refuse",
        "excerpt_retained": "refuse",
        "arbitrary_text_retained": "refuse",
        "first_user_message": "refuse_manufacture"
      }
    },
    {
      "id": "T03-08",
      "rule": "Capability stages defined, available, and loaded require separate observations. Availability does not imply loading. A text mention is not loaded evidence. An action invocation does not create a loaded stage. Unversioned or unobserved definition version and digest stay unknown, and unobserved source scope stays explicit unknown rather than production.",
      "input": {
        "definition": {
          "semantic_version": null,
          "definition_digest": null
        },
        "text_mention": true,
        "state_observations": [
          {
            "stage": "available"
          }
        ],
        "source_scope_observed": false,
        "action": {
          "category": "invocation",
          "status": "attempted",
          "capability_definition": "cap-1"
        }
      },
      "expected": {
        "status": "accept",
        "stage_available": "accepted",
        "stage_loaded": "refuse_inference",
        "text_mention_as_loaded": "refuse",
        "invocation_creates_loaded_stage": "refuse",
        "semantic_version": "version_unknown",
        "definition_digest": "unknown",
        "source_scope": "unknown",
        "production_default": "refuse"
      }
    },
    {
      "id": "T03-09",
      "rule": "A participant may hold many concurrent assignments. Each assignment binds only its own work and half-open interval, never the worker's complete session. Usage attaches only with source-backed membership in that assignment.",
      "input": {
        "participant": "worker-1",
        "session_interval_us": {
          "start": 0,
          "end": 30
        },
        "assignments": [
          {
            "id": "asg-a",
            "work": "w1",
            "interval_us": {
              "start": 0,
              "end": 10
            }
          },
          {
            "id": "asg-b",
            "work": "w2",
            "interval_us": {
              "start": 5,
              "end": 15
            }
          }
        ],
        "usage": [
          {
            "id": "u1",
            "interval_us": {
              "start": 1,
              "end": 2
            },
            "membership": "asg-a"
          },
          {
            "id": "u2",
            "interval_us": {
              "start": 6,
              "end": 7
            },
            "membership": "asg-b"
          },
          {
            "id": "u3",
            "interval_us": {
              "start": 20,
              "end": 21
            },
            "membership": null
          }
        ]
      },
      "expected": {
        "status": "accept",
        "concurrent_assignments": "accepted",
        "u1_attached_to": [
          "asg-a"
        ],
        "u2_attached_to": [
          "asg-b"
        ],
        "u3_attached_to": [],
        "whole_session_binding": "refuse",
        "u2_attachment_basis": "source_asserted_membership",
        "u2_time_overlap_alone": "refuse",
        "u3_retained_scope": "shared_or_unattributed"
      }
    },
    {
      "id": "T03-10",
      "rule": "Inclusive closure starts at the assignment-bound observations of v and follows only evidenced spawn and delegate_existing target closures. In the diamond, P spawns A and B and both delegate to the same existing D. D has no additional spawn origin from those delegates. Shared descendant observations are unioned once. Whole conversations are not imported.",
      "input": {
        "assignments": [
          "asg-p",
          "asg-a",
          "asg-b",
          "asg-d"
        ],
        "edges": [
          {
            "kind": "spawn",
            "from": "asg-p",
            "to": "asg-a",
            "status": "evidenced"
          },
          {
            "kind": "spawn",
            "from": "asg-p",
            "to": "asg-b",
            "status": "evidenced"
          },
          {
            "kind": "delegate_existing",
            "from": "asg-a",
            "to": "asg-d",
            "status": "evidenced"
          },
          {
            "kind": "delegate_existing",
            "from": "asg-b",
            "to": "asg-d",
            "status": "evidenced"
          }
        ]
      },
      "expected": {
        "status": "accept",
        "spawn_origin_of_d": "unknown",
        "creators_of_a": [
          "asg-p"
        ],
        "creators_of_b": [
          "asg-p"
        ],
        "delegate_counts_as_spawn_origin": "refuse",
        "inclusive_p_assignments": [
          "asg-p",
          "asg-a",
          "asg-b",
          "asg-d"
        ],
        "d_included_times": 1,
        "whole_conversation_imported": "refuse",
        "spawn_origins_from_delegate_edges": 0
      }
    },
    {
      "id": "T03-11",
      "rule": "A spawned attempt has one evidenced creator. Two evidenced creators for that attempt mark conflict. Conflicting evidence is preserved and is ineligible for reachability. No creator is selected and no quiet accepted sum replaces the conflict.",
      "input": {
        "target_attempt": "attempt-c",
        "edges": [
          {
            "kind": "spawn",
            "creator": "asg-p1",
            "status": "evidenced"
          },
          {
            "kind": "spawn",
            "creator": "asg-p2",
            "status": "evidenced"
          }
        ]
      },
      "expected": {
        "status": "conflict",
        "evidence": "preserved",
        "reachability": "ineligible",
        "selected_creator": "none",
        "quiet_accepted_sum": "refuse"
      }
    },
    {
      "id": "T03-12",
      "rule": "Usage attaches to an assignment only with source-backed attempt or interval membership. A straddling aggregate cannot be prorated from elapsed time. Ambiguous membership goes to shared or unattributed scope.",
      "input": {
        "aggregate": {
          "interval_us": {
            "start": 0,
            "end": 10
          },
          "amount": 100
        },
        "assignment_interval_us": {
          "start": 4,
          "end": 9
        },
        "finer_membership_evidence": false
      },
      "expected": {
        "status": "accept",
        "prorated_amount": "refuse",
        "elapsed_fraction_applied": "refuse",
        "scope": "shared_or_unattributed"
      }
    },
    {
      "id": "T03-13",
      "rule": "Return, join, and handoff do not expand inclusive closure and do not import a persistent session. Interaction cycles are legal and do not taint the spawn DAG.",
      "input": {
        "edges": [
          {
            "kind": "return",
            "from": "asg-e",
            "to": "asg-c",
            "status": "evidenced"
          },
          {
            "kind": "join",
            "from": "asg-c",
            "to": "asg-e",
            "status": "evidenced"
          },
          {
            "kind": "handoff",
            "from": "asg-e",
            "to": "asg-s",
            "status": "evidenced"
          }
        ],
        "session_usage_outside_assignment": true
      },
      "expected": {
        "status": "accept",
        "inclusive_expansion": "refuse",
        "session_import": "refuse",
        "interaction_cycle": "legal",
        "spawn_dag_tainted": "refuse"
      }
    },
    {
      "id": "T03-14",
      "rule": "An answer takes event window, knowledge cutoff, and revision policy. The sole v1 policy is corrections_at_cutoff_v1. It uses only revisions ingested by the cutoff, then applies valid corrections and retractions. A later ingestion cannot change that answer.",
      "input": {
        "event_window": {
          "start": 0,
          "end": 100
        },
        "knowledge_cutoff": 200,
        "revision_policy": "corrections_at_cutoff_v1",
        "revisions": [
          {
            "revision": 1,
            "ingested_at": 150,
            "digest": "d1"
          },
          {
            "revision": 2,
            "ingested_at": 250,
            "digest": "d2",
            "corrects": 1
          }
        ],
        "other_policy": "latest_wins"
      },
      "expected": {
        "status": "accept",
        "policy": "corrections_at_cutoff_v1",
        "eligible_revisions": [
          1
        ],
        "excluded_revisions": [
          2
        ],
        "answer_revision": 1,
        "other_policy": "refuse",
        "later_ingestion_mutates_answer": "refuse"
      }
    },
    {
      "id": "T03-15",
      "rule": "Corrections are append-only. The same revision and digest is idempotent. The same revision with different content is conflict, with both contents remaining visible. A retraction must reference an exact prior fact.",
      "input": {
        "duplicate": {
          "revision": 3,
          "digest": "da",
          "content": "X",
          "copies": 2
        },
        "divergent": {
          "revision": 3,
          "digest": "db",
          "content": "Y"
        },
        "retraction_target": null
      },
      "expected": {
        "duplicate_status": "idempotent",
        "stored_copies_of_x": 1,
        "divergent_status": "conflict",
        "silent_overwrite": "refuse",
        "both_contents_visible": "accept",
        "retraction": "refuse",
        "fabricated_retraction_target": "refuse"
      }
    },
    {
      "id": "T03-16",
      "rule": "Before equality, fact-revision comparison, serialization, and hashing, normalize a decimal amount by stripping trailing decimal zeros to the minimal positive power-of-ten denominator. Zero is 0/1. Sign belongs only to the numerator. Source precision stays; ISO display scale is not written into canonical storage. Only display rounds, half-even to a declared scale. Canonical digests do not round.",
      "input": {
        "same_source_key": "sk-1",
        "same_revision": 7,
        "amounts": [
          {
            "currency": "USD",
            "coefficient": 10,
            "denominator": 100
          },
          {
            "currency": "USD",
            "coefficient": 1,
            "denominator": 10
          },
          {
            "currency": "USD",
            "coefficient": 0,
            "denominator": 100
          },
          {
            "currency": "USD",
            "coefficient": -250,
            "denominator": 100
          },
          {
            "currency": "USD",
            "coefficient": 25,
            "denominator": 10
          },
          {
            "currency": "USD",
            "coefficient": 1,
            "denominator": -10
          }
        ],
        "declared_display_scale": 0
      },
      "expected": {
        "usd_10_over_100": {
          "coefficient": 1,
          "denominator": 10
        },
        "usd_1_over_10": {
          "coefficient": 1,
          "denominator": 10
        },
        "same_key_revision_equal": true,
        "canonical_digest_equal": true,
        "zero": {
          "coefficient": 0,
          "denominator": 1
        },
        "negative": {
          "coefficient": -25,
          "denominator": 10
        },
        "negative_denominator": "refuse",
        "iso_scale_rewrites_canonical": "refuse",
        "display_half_even_of_25_over_10_at_scale_0": 2,
        "canonical_after_display": {
          "coefficient": 25,
          "denominator": 10
        },
        "canonical_rounded": "refuse",
        "source_precision_metadata": "retained_separate_from_canonical"
      }
    },
    {
      "id": "T03-17",
      "rule": "Invalid timestamps stay rejected evidence counters. They are not clamped to zero and are not used as event time. A valid signed microsecond value is not invalid merely because it is negative.",
      "input": {
        "invalid_event_time": "not-a-timestamp",
        "valid_negative_event_time_us": -15
      },
      "expected": {
        "invalid_status": "rejected_evidence",
        "rejected_count": 1,
        "clamped_to_zero": "refuse",
        "used_as_event_time": "refuse",
        "negative_signed_timestamp": "accept"
      }
    },
    {
      "id": "T03-18",
      "rule": "Coverage axes stay independent. A complete scan with no eligible facts yields observed zero. With no known expected denominator, report counts and gap reasons only. An acceptance fraction is acceptance of encountered records, not total sensor coverage.",
      "input": {
        "scan": {
          "discovery": "present",
          "read": "complete",
          "projection": "supported",
          "eligible_facts": 0,
          "expected_population": null
        },
        "encountered": {
          "accepted": 2,
          "rejected": 1,
          "recognized_unprojected": 1
        }
      },
      "expected": {
        "status": "accept",
        "observed_count": 0,
        "completeness_percentage": "refuse",
        "sensor_coverage_percentage": "refuse",
        "acceptance_of_encountered": {
          "numerator": 2,
          "denominator": 4
        },
        "acceptance_labeled_sensor_coverage": "refuse",
        "accepted_2_disposition": "outside_query_window_or_noneligible",
        "observed_zero_means_zero_accepted": "refuse"
      }
    },
    {
      "id": "T03-19",
      "rule": "Resume is a later segment of the same attempt only when continuation is evidenced. Otherwise it stays unresolved and is not a fabricated retry or a new attempt.",
      "input": {
        "prior_segment": "seg-1",
        "later_segment": "seg-2",
        "continuation_proven": false
      },
      "expected": {
        "status": "unresolved",
        "same_attempt_resume": "refuse",
        "fabricated_retry": "refuse",
        "fabricated_attempt": "refuse"
      }
    },
    {
      "id": "T03-20",
      "rule": "Eligible spawn closure that contains a cycle is quarantined. Independent direct totals survive. The cycle is not condensed into a quietly accepted sum.",
      "input": {
        "edges": [
          {
            "kind": "spawn",
            "from": "asg-a",
            "to": "asg-b",
            "status": "evidenced"
          },
          {
            "kind": "spawn",
            "from": "asg-b",
            "to": "asg-a",
            "status": "evidenced"
          }
        ],
        "direct_total_a": 10
      },
      "expected": {
        "status": "quarantine",
        "inclusive_fold": "quarantined",
        "direct_total_a": 10,
        "quiet_accepted_sum": "refuse",
        "facts_deleted": "refuse"
      }
    }
  ],
