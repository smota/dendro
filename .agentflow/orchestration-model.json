{
  "lifecycle": "parallel-spec-fork",
  "preCodeReview": {
    "enabled": true,
    "gate": "specification-sparring",
    "targetPhases": [
      "architect",
      "implementation-planner"
    ],
    "blockingSeverity": [
      "blocker",
      "structural"
    ]
  },
  "parallelTracks": {
    "afterG1Contract": [
      "dev.test-eng",
      "dev.build",
      "technical-writer"
    ],
    "onPullRequest": [
      "dev.qa",
      "rev.review"
    ]
  },
  "concurrency": {
    "maxWriters": 4,
    "maxConcurrentSlices": 4,
    "maxWritersPerWorktree": 1,
    "maxAdvisors": 3,
    "isolatedWorktreeRequired": true,
    "worktreeRoot": ".worktrees"
  }
}
