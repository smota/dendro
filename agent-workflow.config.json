{
  "posture": "autonomous",
  "ciCommands": [
    "cargo check --workspace",
    "cargo test --workspace"
  ],
  "bounded": {
    "allowedExactPaths": [
      "README.md"
    ],
    "allowedPathPrefixes": [
      "docs/"
    ],
    "deniedPathFragments": [],
    "defaultBase": "origin/main"
  },
  "branching": {
    "trunk": "main",
    "releaseCandidate": null,
    "integration": "main",
    "directEditDeniedBranches": [
      "main"
    ],
    "defaultPrTarget": "main",
    "promotionOrder": [
      "main"
    ],
    "workBranchPrefixes": [
      "work/",
      "feature/",
      "fix/",
      "hotfix/",
      "spike/",
      "chore/"
    ],
    "compatibilityBranchPrefixes": [
      "issue/",
      "wt/",
      "claude/"
    ],
    "requireBoundedWorkBranch": true
  },
  "integrationLifecycle": {
    "integrationBranch": "main",
    "trunkBranch": "main",
    "referenceKeywords": [
      "Implements"
    ],
    "addLabels": [
      "integrated:main",
      "awaiting-release"
    ],
    "closeIntegratedIssues": true
  },
  "routing": {
    "defaultMode": "single-agent"
  },
  "collaboration": {
    "defaultMode": "auto-minimal",
    "sensitiveSurfaces": [
      "security",
      "auth",
      "data",
      "infra",
      "billing"
    ],
    "councilDomainThreshold": 3,
    "bilateralDomainThreshold": 2,
    "councilOnPublicContract": true,
    "councilOnMigration": true,
    "councilHelpers": [
      "risk-scout",
      "implementation-strategist",
      "testability-scout",
      "docs-impact-scout"
    ],
    "discoveryHelpers": [
      "requirements-scout",
      "architecture-scout"
    ],
    "councilSeats": [
      {
        "role": "agentflow:architect",
        "focus": "architecture and system boundaries",
        "required": true
      },
      {
        "role": "agentflow:developer",
        "focus": "implementation feasibility",
        "required": true
      },
      {
        "role": "agentflow:tester",
        "focus": "testability and failure evidence",
        "required": true
      },
      {
        "role": "agentflow:reviewer",
        "focus": "risk and maintainability",
        "required": true
      }
    ],
    "fallbackModes": [
      "sequential",
      "manual"
    ],
    "maxDelegates": 4,
    "maxDepth": 1,
    "maxIterations": 3
  },
  "extensions": {
    "enabledPacks": []
  },
  "delivery": {
    "source": {
      "kind": "local-preview"
    },
    "candidate": {
      "inputs": []
    }
  },
  "gateNotifications": {
    "hookUrl": null
  },
  "executionTopology": {
    "substrateTier": "auto",
    "openrigSquadPreset": "lean-4-seat",
    "compositeBuilderMaxRung": "P1",
    "requireOrthogonalReviewFamily": true
  },
  "effortPolicy": {
    "defaultLoopEffort": "medium",
    "subagentSearchEffort": "low",
    "highEffortMaxContextTokens": 40000,
    "enforceCleanSubagentForHighEffort": true
  },
  "adapters": {
    "openrig": {
      "executionPolicy": {
        "activation": "held",
        "preset": "all-codex",
        "seats": {
          "orch.arch": {
            "runtime": "codex",
            "providerRoute": "openai-codex",
            "model": "gpt-6.1-sol",
            "effort": "medium",
            "profile": "architect"
          },
          "dev.build": {
            "runtime": "pi",
            "providerRoute": "munito",
            "model": "qwen/qwen3.8-27b",
            "effort": "medium",
            "profile": "builder-pi"
          },
          "dev.qa": {
            "runtime": "codex",
            "providerRoute": "openai-codex",
            "model": "gpt-6.1-sol",
            "effort": "low",
            "profile": "qa"
          },
          "rev.review": {
            "runtime": "claude-code",
            "providerRoute": "anthropic",
            "model": "claude-sonnet-5-5",
            "effort": "medium",
            "profile": "reviewer"
          },
          "eval.tester": {
            "runtime": "codex",
            "providerRoute": "openai-codex",
            "model": "gpt-6.1-sol",
            "effort": "low",
            "profile": "eval-tester"
          },
          "pm.manager": {
            "runtime": "codex",
            "providerRoute": "openai-codex",
            "model": "gpt-6.1-sol",
            "effort": "medium",
            "profile": "product-manager"
          },
          "pm.analyst": {
            "runtime": "codex",
            "providerRoute": "openai-codex",
            "model": "gpt-6.1-sol",
            "effort": "medium",
            "profile": "analyst"
          },
          "steer.lead": {
            "runtime": "codex",
            "providerRoute": "openai-codex",
            "model": "gpt-6.1-sol",
            "effort": "medium",
            "profile": "steering-lead"
          }
        }
      }
    }
  }
}
